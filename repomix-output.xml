// ═══════════════════════════════════════════════
// STATE MANAJEMEN APLIKASI
// ═══════════════════════════════════════════════
const DAYS = ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"];
const MEALS = ["Sarapan", "Makan Siang", "Makan Malam"];

let currentPlan = {};       // format: { "Senin-Sarapan": 1, ... }
let checkedGrocery = {};    // format: { "Bayam segar": true, ... }
let activeFilter = "all";
let searchKeyword = "";
let pendingSlot = null;     // { day, meal }

// Format Mata Uang Rupiah
function toIDR(num) {
  return "Rp" + Math.round(num).toLocaleString("id-ID");
}

function getBudgetLimit() {
  const input = document.getElementById("budgetInput");
  const val = parseInt(input.value, 10);
  return isNaN(val) ? 0 : val;
}

function calculatePlanTotalCost() {
  let sum = 0;
  for (const slotKey in currentPlan) {
    const recipeId = currentPlan[slotKey];
    const rec = RECIPES_DATA.find(r => r.id === recipeId);
    if (rec) sum += rec.totalHarga;
  }
  return sum;
}

function calculateDayTotalCost(day) {
  let sum = 0;
  MEALS.forEach(meal => {
    const key = `${day}-${meal}`;
    const id = currentPlan[key];
    if (id) {
      const rec = RECIPES_DATA.find(r => r.id === id);
      if (rec) sum += rec.totalHarga;
    }
  });
  return sum;
}

// ═══════════════════════════════════════════════
// RENDER JADWAL MENU (TABLE)
// ═══════════════════════════════════════════════
function renderPlanTable() {
  const table = document.getElementById("mealTable");
  let html = "<thead><tr><th>Waktu</th>";
  DAYS.forEach(day => {
    html += `<th>${day}</th>`;
  });
  html += "</tr></thead><tbody>";

  MEALS.forEach(meal => {
    html += `<tr><td class="row-header">${meal}</td>`;
    DAYS.forEach(day => {
      const key = `${day}-${meal}`;
      const recId = currentPlan[key];
      const rec = recId ? RECIPES_DATA.find(r => r.id === recId) : null;

      if (rec) {
        html += `
          <td>
            <div class="slot-card has-recipe" onclick="openSlotPicker('${day}', '${meal}')">
              <div>
                <div class="slot-title">${rec.nama}</div>
              </div>
              <div class="slot-meta">
                <span class="slot-price">${toIDR(rec.totalHarga)}</span>
                <button type="button" class="slot-remove" title="Hapus menu ini" onclick="event.stopPropagation(); removeSlotRecipe('${key}')">&times;</button>
              </div>
            </div>
          </td>
        `;
      } else {
        html += `
          <td>
            <div class="slot-card" onclick="openSlotPicker('${day}', '${meal}')">
              <span class="slot-empty">+ Pilih Resep</span>
            </div>
          </td>
        `;
      }
    });
    html += "</tr>";
  });

  // Daily Subtotals Row
  html += `<tr><td class="row-header" style="font-size:0.76rem; text-transform:uppercase;">Biaya Harian</td>`;
  DAYS.forEach(day => {
    const daySum = calculateDayTotalCost(day);
    html += `<td class="day-sum-cell">${toIDR(daySum)}</td>`;
  });
  html += `</tr></tbody>`;

  table.innerHTML = html;
  updateBudgetMetrics();
  renderShoppingList();
}

function removeSlotRecipe(slotKey) {
  delete currentPlan[slotKey];
  renderPlanTable();
  showToast("Menu dihapus dari jadwal.");
}

function clearAllPlan() {
  if (confirm("Kosongkan semua rencana makan untuk 7 hari?")) {
    currentPlan = {};
    renderPlanTable();
    showToast("Jadwal menu telah dikosongkan.");
  }
}

// ═══════════════════════════════════════════════
// UPDATE BUDGET METRICS
// ═══════════════════════════════════════════════
function updateBudgetMetrics() {
  const budget = getBudgetLimit();
  const used = calculatePlanTotalCost();
  const diff = budget - used;

  document.getElementById("dispBudget").textContent = toIDR(budget);
  document.getElementById("dispUsed").textContent = toIDR(used);

  const chipDiff = document.getElementById("chipDiff");
  const diffLabel = chipDiff.querySelector(".lbl");
  const diffVal = document.getElementById("dispDiff");

  if (diff >= 0) {
    chipDiff.className = "stat-chip safe";
    diffLabel.textContent = "Sisa Anggaran";
    diffVal.textContent = toIDR(diff);
  } else {
    chipDiff.className = "stat-chip exceeded";
    diffLabel.textContent = "Melebihi Anggaran";
    diffVal.textContent = toIDR(Math.abs(diff));
  }
}

document.getElementById("budgetInput").addEventListener("input", () => {
  updateBudgetMetrics();
});

// ═══════════════════════════════════════════════
// ALGORITMA REKOMENDASI OTOMATIS SESUAI BUDGET
// ═══════════════════════════════════════════════
function triggerAutoPlan() {
  const budget = getBudgetLimit();
  if (budget <= 0) {
    alert("Silakan masukkan nilai anggaran mingguan yang valid.");
    return;
  }

  const newPlan = {};
  const mealMap = {
    "Sarapan": "sarapan",
    "Makan Siang": "makan siang",
    "Makan Malam": "makan malam"
  };

  const avgPerMeal = budget / 21; // 21 waktu makan dalam seminggu

  DAYS.forEach(day => {
    MEALS.forEach(meal => {
      const cat = mealMap[meal];
      let candidates = RECIPES_DATA.filter(r => r.kategori.includes(cat));
      if (candidates.length === 0) candidates = RECIPES_DATA;

      // Filter preferensi harga yang tidak melampaui rata-rata porsi + 25%
      let viable = candidates.filter(r => r.totalHarga <= (avgPerMeal * 1.35));
      if (viable.length === 0) {
        viable = candidates.sort((a, b) => a.totalHarga - b.totalHarga).slice(0, 4);
      }

      const randomPick = viable[Math.floor(Math.random() * viable.length)];
      newPlan[`${day}-${meal}`] = randomPick.id;
    });
  });

  currentPlan = newPlan;
  renderPlanTable();
  showToast("Jadwal menu mingguan otomatis telah disusun sesuai anggaran.");
}

// ═══════════════════════════════════════════════
// KATALOG RESEP & FILTER
// ═══════════════════════════════════════════════
function renderRecipeCatalog() {
  const container = document.getElementById("recipesGridContainer");
  const filtered = RECIPES_DATA.filter(recipe => {
    const q = searchKeyword.toLowerCase().trim();
    const matchSearch = !q ||
      recipe.nama.toLowerCase().includes(q) ||
      recipe.bahan.some(b => b.nama.toLowerCase().includes(q)) ||
      recipe.tags.some(t => t.toLowerCase().includes(q));

    if (!matchSearch) return false;

    if (activeFilter === "all") return true;
    if (activeFilter === "hemat") return recipe.totalHarga < 5000;
    if (activeFilter === "cepat") return recipe.waktuMenit <= 15;
    if (activeFilter === "tinggi-protein") return recipe.tags.includes("tinggi-protein");
    if (activeFilter === "sayuran") return recipe.tags.includes("sayuran");
    return recipe.kategori.includes(activeFilter);
  });

  if (filtered.length === 0) {
    container.innerHTML = `
      <div style="grid-column: 1 / -1; padding: 40px; text-align: center; color: var(--text-muted); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
        Tidak ditemukan resep yang sesuai dengan kata kunci atau filter saat ini.
      </div>
    `;
    return;
  }

  container.innerHTML = filtered.map(r => `
    <div class="recipe-item" onclick="openRecipeDetailModal(${r.id})">
      <div>
        <div class="recipe-header-row">
          <div class="recipe-item-name">${r.nama}</div>
          <div class="recipe-price-tag">${toIDR(r.totalHarga)}</div>
        </div>
        <div class="recipe-item-metrics">
          <span>${r.waktuMenit} menit</span>
          <span>${r.kalori} kkal</span>
          <span>${r.protein}g protein</span>
        </div>
        <div class="recipe-item-tags">
          ${r.kategori.map(k => `<span class="tag-pill">${k}</span>`).join("")}
          ${r.tags.map(t => `<span class="tag-pill">${t}</span>`).join("")}
        </div>
      </div>
      <div class="recipe-card-footer">
        <span style="font-size:0.75rem; color:var(--text-subtle);">${r.bahan.length} bahan</span>
        <button type="button" class="btn-add-plan" onclick="event.stopPropagation(); quickAddToNextAvailableSlot(${r.id})">+ Ke Jadwal</button>
      </div>
    </div>
  `).join("");
}

function quickAddToNextAvailableSlot(recipeId) {
  // Cari slot kosong pertama
  for (const day of DAYS) {
    for (const meal of MEALS) {
      const key = `${day}-${meal}`;
      if (!currentPlan[key]) {
        currentPlan[key] = recipeId;
        renderPlanTable();
        const rec = RECIPES_DATA.find(r => r.id === recipeId);
        showToast(`Ditambahkan ke ${day} (${meal}): ${rec.nama}`);
        return;
      }
    }
  }
  showToast("Semua slot jadwal sudah penuh. Klik slot langsung untuk mengganti.");
}

// Event Listeners Filter Resep
document.getElementById("filterContainer").addEventListener("click", e => {
  if (!e.target.classList.contains("filter-btn")) return;
  document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
  e.target.classList.add("active");
  activeFilter = e.target.dataset.filter;
  renderRecipeCatalog();
});

document.getElementById("recipeSearchInput").addEventListener("input", e => {
  searchKeyword = e.target.value;
  renderRecipeCatalog();
});

// ═══════════════════════════════════════════════
// DAFTAR BELANJA PASAR OTOMATIS
// ═══════════════════════════════════════════════
function renderShoppingList() {
  const grid = document.getElementById("shoppingGridContainer");
  const aggregated = {}; // nama: { jumlah: [], harga: 0, gerai: "" }

  for (const slot in currentPlan) {
    const id = currentPlan[slot];
    const rec = RECIPES_DATA.find(r => r.id === id);
    if (!rec) continue;

    rec.bahan.forEach(item => {
      if (!aggregated[item.nama]) {
        aggregated[item.nama] = {
          count: 0,
          jumlah: item.jumlah,
          harga: 0,
          gerai: item.gerai || "Lainnya"
        };
      }
      aggregated[item.nama].count += 1;
      aggregated[item.nama].harga += item.harga;
    });
  }

  const itemsArray = Object.keys(aggregated);
  if (itemsArray.length === 0) {
    grid.innerHTML = `
      <div style="grid-column: 1 / -1; padding: 36px; text-align: center; color: var(--text-muted); background: var(--surface); border: 1px dashed var(--border); border-radius: var(--radius-md);">
        Daftar belanja masih kosong. Tambahkan menu ke jadwal untuk membuat daftar bahan otomatis.
      </div>
    `;
    document.getElementById("totalShoppingCost").textContent = "Rp0";
    return;
  }

  // Kelompokkan berdasarkan gerai
  const categories = {
    "Sayuran": [],
    "Protein": [],
    "Sembako": [],
    "Bumbu": []
  };

  let totalCost = 0;

  for (const name in aggregated) {
    const entry = aggregated[name];
    totalCost += entry.harga;
    const cat = categories[entry.gerai] ? entry.gerai : "Sembako";
    categories[cat].push({
      nama: name,
      qty: entry.count > 1 ? `${entry.jumlah} (&times;${entry.count} porsi)` : entry.jumlah,
      harga: entry.harga
    });
  }

  document.getElementById("totalShoppingCost").textContent = toIDR(totalCost);

  let html = "";
  for (const [catName, list] of Object.entries(categories)) {
    if (list.length === 0) continue;
    html += `
      <div class="shopping-card">
        <div class="shopping-card-title">${catName} (${list.length} item)</div>
        <div>
          ${list.map(item => {
            const isChecked = !!checkedGrocery[item.nama];
            return `
              <div class="shopping-row ${isChecked ? "checked" : ""}">
                <label class="shopping-label">
                  <input type="checkbox" ${isChecked ? "checked" : ""} onchange="toggleGroceryItem('${item.nama}', this)">
                  <span class="item-title">${item.nama} <span style="font-size:0.75rem; color:var(--text-subtle);">(${item.qty})</span></span>
                </label>
                <span class="item-cost">${toIDR(item.harga)}</span>
              </div>
            `;
          }).join("")}
        </div>
      </div>
    `;
  }

  grid.innerHTML = html;
}

function toggleGroceryItem(itemName, checkbox) {
  checkedGrocery[itemName] = checkbox.checked;
  const row = checkbox.closest(".shopping-row");
  if (row) {
    row.classList.toggle("checked", checkbox.checked);
  }
}

function resetCheckedItems() {
  checkedGrocery = {};
  renderShoppingList();
  showToast("Status centang daftar belanja telah direset.");
}

function copyShoppingListText() {
  const aggregated = {};
  for (const slot in currentPlan) {
    const id = currentPlan[slot];
    const rec = RECIPES_DATA.find(r => r.id === id);
    if (!rec) continue;
    rec.bahan.forEach(item => {
      if (!aggregated[item.nama]) {
        aggregated[item.nama] = { count: 0, harga: 0, gerai: item.gerai, qty: item.jumlah };
      }
      aggregated[item.nama].count += 1;
      aggregated[item.nama].harga += item.harga;
    });
  }

  if (Object.keys(aggregated).length === 0) {
    showToast("Jadwal menu masih kosong.");
    return;
  }

  let text = "*DAFTAR BELANJA PASAR — ICAMEAL*\n";
  text += "Estimasi 1 Minggu:\n\n";

  let total = 0;
  for (const name in aggregated) {
    const item = aggregated[name];
    total += item.harga;
    const qtyStr = item.count > 1 ? `${item.qty} (x${item.count})` : item.qty;
    text += `[ ] ${name} - ${qtyStr} : ${toIDR(item.harga)}\n`;
  }

  text += `\n*TOTAL ESTIMASI: ${toIDR(total)}*`;

  navigator.clipboard.writeText(text).then(() => {
    showToast("Daftar belanja disalin ke clipboard!");
  }).catch(() => {
    showToast("Berhasil disalin.");
  });
}

// ═══════════════════════════════════════════════
// MODAL: DETAIL RESEP
// ═══════════════════════════════════════════════
function openRecipeDetailModal(recipeId) {
  const rec = RECIPES_DATA.find(r => r.id === recipeId);
  if (!rec) return;

  const body = document.getElementById("recipeDetailBody");
  body.innerHTML = `
    <h2 style="font-size:1.35rem; font-weight:700; margin-bottom:8px;">${rec.nama}</h2>
    <div style="display:flex; gap:12px; font-size:0.85rem; color:var(--text-muted); margin-bottom:16px;">
      <span>Estimasi: <strong>${toIDR(rec.totalHarga)}</strong></span>
      <span>Waktu: <strong>${rec.waktuMenit} menit</strong></span>
      <span>Kalori: <strong>${rec.kalori} kkal</strong></span>
    </div>

    <div style="background:#F8FAFC; border:1px solid var(--border); border-radius:var(--radius-sm); padding:12px; margin-bottom:18px;">
      <div style="font-size:0.75rem; text-transform:uppercase; font-weight:700; color:var(--text-subtle); margin-bottom:6px;">Profil Nutrisi</div>
      <div style="display:flex; justify-content:space-around; font-size:0.84rem;">
        <div>Protein: <strong>${rec.protein}g</strong></div>
        <div>Karbohidrat: <strong>${rec.karbo}g</strong></div>
        <div>Lemak: <strong>${rec.lemak}g</strong></div>
      </div>
    </div>

    <h4 style="font-size:0.95rem; font-weight:700; margin-bottom:8px;">Rincian Bahan &amp; Harga</h4>
    <ul style="list-style:none; font-size:0.84rem; margin-bottom:20px; border:1px solid var(--border); border-radius:var(--radius-sm);">
      ${rec.bahan.map(b => `
        <li style="display:flex; justify-content:space-between; padding:8px 12px; border-bottom:1px solid #F1F5F9;">
          <span>${b.nama} (${b.jumlah})</span>
          <span style="font-weight:600;">${toIDR(b.harga)}</span>
        </li>
      `).join("")}
    </ul>

    <h4 style="font-size:0.95rem; font-weight:700; margin-bottom:8px;">Langkah Memasak Praktis</h4>
    <ol style="padding-left:20px; font-size:0.84rem; line-height:1.6; color:var(--text-main); margin-bottom:24px;">
      ${rec.langkah.map(step => `<li style="margin-bottom:6px;">${step}</li>`).join("")}
    </ol>

    <button type="button" class="btn btn-primary" style="width:100%;" onclick="quickAddToNextAvailableSlot(${rec.id}); closeModal('recipeDetailModal');">Tambahkan Menu Ini ke Jadwal</button>
  `;

  document.getElementById("recipeDetailModal").classList.add("active");
}

// ═══════════════════════════════════════════════
// MODAL: PEMILIH RESEP UNTUK SLOT JADWAL
// ═══════════════════════════════════════════════
function openSlotPicker(day, meal) {
  pendingSlot = { day, meal };
  document.getElementById("slotPickerHeader").textContent = `Pilih Menu untuk ${day} — ${meal}`;
  document.getElementById("slotSearchField").value = "";
  renderSlotPickerItems("");
  document.getElementById("slotPickerModal").classList.add("active");
}

function filterSlotList() {
  const query = document.getElementById("slotSearchField").value;
  renderSlotPickerItems(query);
}

function renderSlotPickerItems(query) {
  const container = document.getElementById("slotPickerList");
  const q = query.toLowerCase().trim();

  const filtered = RECIPES_DATA.filter(r => {
    return !q || r.nama.toLowerCase().includes(q) || r.bahan.some(b => b.nama.toLowerCase().includes(q));
  });

  if (filtered.length === 0) {
    container.innerHTML = `<div style="padding:16px; text-align:center; color:var(--text-muted); font-size:0.85rem;">Tidak ada menu yang sesuai.</div>`;
    return;
  }

  container.innerHTML = filtered.map(r => `
    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 12px; border:1px solid var(--border); border-radius:var(--radius-sm); cursor:pointer; background:#FFFFFF;" 
         onmouseover="this.style.borderColor='var(--border-strong)'" 
         onmouseout="this.style.borderColor='var(--border)'"
         onclick="assignRecipeToSlot(${r.id})">
      <div>
        <div style="font-size:0.9rem; font-weight:600;">${r.nama}</div>
        <div style="font-size:0.75rem; color:var(--text-subtle);">${r.waktuMenit} menit &bull; ${r.kalori} kkal</div>
      </div>
      <div style="font-size:0.86rem; font-weight:700; color:var(--primary);">${toIDR(r.totalHarga)}</div>
    </div>
  `).join("");
}

function assignRecipeToSlot(recipeId) {
  if (!pendingSlot) return;
  const key = `${pendingSlot.day}-${pendingSlot.meal}`;
  currentPlan[key] = recipeId;
  closeModal("slotPickerModal");
  renderPlanTable();
  const rec = RECIPES_DATA.find(r => r.id === recipeId);
  showToast(`Menu ditetapkan: ${rec.nama}`);
}

function closeModal(modalId) {
  document.getElementById(modalId).classList.remove("active");
}

function closeBackdrop(event, modalId) {
  if (event.target.id === modalId) {
    closeModal(modalId);
  }
}

// ═══════════════════════════════════════════════
// LOCAL STORAGE PERSISTENCE
// ═══════════════════════════════════════════════
function savePlanToStorage() {
  localStorage.setItem("icameal_plan_v2", JSON.stringify(currentPlan));
  localStorage.setItem("icameal_budget_v2", getBudgetLimit().toString());
  showToast("Jadwal menu berhasil disimpan ke memori browser.");
}

function loadPlanFromStorage() {
  const savedPlan = localStorage.getItem("icameal_plan_v2");
  if (savedPlan) {
    try {
      currentPlan = JSON.parse(savedPlan);
    } catch (e) {
      currentPlan = {};
    }
  }
  const savedBudget = localStorage.getItem("icameal_budget_v2");
  if (savedBudget) {
    document.getElementById("budgetInput").value = savedBudget;
  }
}

function showToast(msg) {
  const toast = document.getElementById("toastBox");
  toast.textContent = msg;
  toast.classList.add("show");
  setTimeout(() => {
    toast.classList.remove("show");
  }, 2600);
}

// ═══════════════════════════════════════════════
// INISIALISASI
// ═══════════════════════════════════════════════
window.addEventListener("DOMContentLoaded", () => {
  loadPlanFromStorage();
  renderPlanTable();
  renderRecipeCatalog();
  updateBudgetMetrics();
});
</script>
