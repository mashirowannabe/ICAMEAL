  color: var(--text-main);
}

.budget-stats {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.stat-chip {
  padding: 8px 14px;
  border-radius: var(--radius-sm);
  font-size: 0.86rem;
  display: flex;
  flex-direction: column;
}

.stat-chip .lbl {
  font-size: 0.72rem;
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: 2px;
}

.stat-chip .val {
  font-size: 1.05rem;
  font-weight: 700;
}

.stat-chip.total {
  background: #F1F5F9;
  border: 1px solid #CBD5E1;
  color: var(--text-main);
}
.stat-chip.total .lbl { color: var(--text-subtle); }

.stat-chip.used {
  background: #FFF8E1;
  border: 1px solid #FFE082;
  color: #E65100;
}
.stat-chip.used .lbl { color: #8D6E63; }

.stat-chip.safe {
  background: var(--success-bg);
  border: 1px solid var(--success-border);
  color: var(--success-text);
}
.stat-chip.safe .lbl { color: #2E7D32; }

.stat-chip.exceeded {
  background: var(--danger-bg);
  border: 1px solid var(--danger-border);
  color: var(--danger-text);
}
.stat-chip.exceeded .lbl { color: #C62828; }

/* ── Meal Planner Table ── */
.table-scroll {
  overflow-x: auto;
