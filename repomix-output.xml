  display: flex;
  align-items: center;
  gap: 12px;
}

.budget-input-wrapper label {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-main);
}

.input-rupiah {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 0 12px;
  font-weight: 600;
}

.input-rupiah input {
  border: none;
  outline: none;
