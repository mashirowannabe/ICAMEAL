}

.shopping-summary-bar {
  background: var(--dark-panel);
  color: #FFFFFF;
  padding: 18px 24px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

