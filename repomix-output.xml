  flex-direction: column;
  justify-content: space-between;
}

.pkg-card.featured {
  border: 2px solid var(--primary);
  background: #FFFAF5;
}

.pkg-name {
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 6px;
}

.pkg-price {
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 12px;
}

.pkg-desc {
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin-bottom: 16px;
}

.pkg-list {
  list-style: none;
  font-size: 0.82rem;
  color: var(--text-main);
  margin-bottom: 20px;
}

.pkg-list li {
  padding: 4px 0;
  display: flex;
  align-items: baseline;
  gap: 6px;
}

/* ── Modal ── */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
